@* ============================================================
   Views/Clientes/Edit.cshtml
   Formulário de alteração — igual ao Create mas com dados preenchidos
   O Model Pessoa já vem preenchido do banco via Controller
============================================================ *@

@model Pessoa

@{
    ViewData["Title"]         = "Alterar Cliente";
    ViewData["SidebarTitulo"] = "Clientes";
}

@section SidebarMenu {
    <a asp-action="Create" class="nav-link">
        <i class="bi bi-plus-circle me-2"></i>Cadastrar
    </a>
    <a asp-action="Index" class="nav-link">
        <i class="bi bi-list-ul me-2"></i>Listar
    </a>
    <a class="nav-link active">
        <i class="bi bi-pencil me-2"></i>Alterar
    </a>
}

@section HeaderNav {
    <div class="d-flex gap-4">
        <a asp-controller="Fornecedores" asp-action="Index" class="text-decoration-none" style="color:#8b6f47">Fornecedores</a>
        <a asp-controller="Contas" asp-action="Index" class="text-decoration-none" style="color:#8b6f47">Contas</a>
    </div>
}

<div class="card shadow-sm" style="max-width:860px">
    <div class="card-body p-4">
        <h2 class="fw-normal mb-4">Alterar Cliente</h2>

        @*
            asp-route-id passa o Id na URL: POST /Clientes/Edit/5
            O Controller Edit(int id, Pessoa pessoa) recebe os dois
        *@
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="All" class="alert alert-danger"
                 style="display:@(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")"></div>

            <h5 class="text-muted border-bottom pb-2 mb-3">Informações pessoais</h5>
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="Nome" class="form-label"></label>
                    @* asp-for preenche automaticamente com o valor do Model *@
                    <input asp-for="Nome" class="form-control">
                    <span asp-validation-for="Nome" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="NomeSocial" class="form-label">Nome Social</label>
                    <input asp-for="NomeSocial" class="form-control">
                </div>
            </div>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="Documento" class="form-label">CPF / CNPJ</label>
                    <input asp-for="Documento" class="form-control">
                </div>
                <div class="col-md-6">
                    <label class="form-label">Tipo de Pessoa</label>
                    <select asp-for="TipoPessoa" class="form-select">
                        <option value="F">Pessoa Física</option>
                        <option value="J">Pessoa Jurídica</option>
                    </select>
                </div>
            </div>

            <h5 class="text-muted border-bottom pb-2 mb-3">Informações de localidade</h5>
            <div class="row g-3 mb-3">
                <div class="col-md-3">
                    <label asp-for="Cep" class="form-label">CEP</label>
                    <input asp-for="Cep" class="form-control">
                </div>
                <div class="col-md-5">
                    <label asp-for="Logradouro" class="form-label">Logradouro</label>
                    <input asp-for="Logradouro" class="form-control">
                </div>
                <div class="col-md-4">
                    <label asp-for="Numero" class="form-label">Número</label>
                    <input asp-for="Numero" class="form-control">
                </div>
            </div>
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label asp-for="Bairro" class="form-label">Bairro</label>
                    <input asp-for="Bairro" class="form-control">
                </div>
                <div class="col-md-5">
                    <label asp-for="Cidade" class="form-label">Cidade</label>
                    <input asp-for="Cidade" class="form-control">
                </div>
                <div class="col-md-3">
                    <label asp-for="TipoEndereco" class="form-label">Tipo</label>
                    <select asp-for="TipoEndereco" class="form-select">
                        <option value="Residencial">Residencial</option>
                        <option value="Comercial">Comercial</option>
                    </select>
                </div>
            </div>

            <h5 class="text-muted border-bottom pb-2 mb-3">Informações de contato</h5>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="Telefone" class="form-label">Telefone</label>
                    <input asp-for="Telefone" class="form-control">
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" type="email">
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>
            </div>

            <div class="d-flex gap-2 mt-2">
                <button type="submit" class="btn btn-carrara px-4">
                    <i class="bi bi-check-lg me-1"></i>Salvar Alterações
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
            </div>
        </form>
    </div>
</div>
