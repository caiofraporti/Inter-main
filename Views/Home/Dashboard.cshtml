@{
    ViewData["Title"]         = "Dashboard";
    ViewData["SidebarTitulo"] = "Dashboard";

    var contasVencer    = (List<Lancamento>)ViewBag.ContasVencer;
    var contasRecebidas = (List<Lancamento>)ViewBag.ContasRecebidas;
    var ultimasVendas   = (List<Venda>)ViewBag.UltimasVendas;
    decimal totalVencer   = (decimal)ViewBag.TotalVencer;
    decimal totalRecebido = (decimal)ViewBag.TotalRecebido;
}

@section SidebarMenu {
    <a asp-controller="Vendas"       asp-action="Index" class="nav-link"><i class="bi bi-bag-check me-2"></i>Vendas</a>
    <a asp-controller="Compras"      asp-action="Index" class="nav-link"><i class="bi bi-cart3 me-2"></i>Compras</a>
    <a asp-controller="Produtos"     asp-action="Index" class="nav-link"><i class="bi bi-box-seam me-2"></i>Produtos</a>
    <a asp-controller="Materiais"    asp-action="Index" class="nav-link"><i class="bi bi-layers me-2"></i>Materiais</a>
    <hr style="border-color:rgba(255,255,255,.3)">
    <a asp-controller="Clientes"     asp-action="Index" class="nav-link"><i class="bi bi-people me-2"></i>Clientes</a>
    <a asp-controller="Fornecedores" asp-action="Index" class="nav-link"><i class="bi bi-truck me-2"></i>Fornecedores</a>
    <a asp-controller="Contas"       asp-action="Index" class="nav-link"><i class="bi bi-cash-stack me-2"></i>Contas</a>
    <hr style="border-color:rgba(255,255,255,.3)">
    <a asp-controller="Home" asp-action="Logout" class="nav-link text-warning"><i class="bi bi-box-arrow-right me-2"></i>Sair</a>
}

@section HeaderNav {
    <span class="text-muted">Bem-vindo, <strong>@ViewBag.Usuario</strong></span>
}

<div class="row g-4">

    @* ── Card 1: Contas a vencer nos próximos 30 dias ── *@
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-header d-flex justify-content-between align-items-center py-3"
                 style="background:#8b6f47; color:#fff;">
                <h5 class="mb-0"><i class="bi bi-calendar-x me-2"></i>Contas a Vencer (próximos 30 dias)</h5>
                <span class="badge fs-6 px-3 py-2" style="background:rgba(255,255,255,.2)">
                    Total: R$ @totalVencer.ToString("N2")
                </span>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Parcela</th>
                            <th>Vencimento</th>
                            <th>Valor</th>
                            <th>Tipo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var conta in contasVencer)
                        {
                            var link    = conta.VendaCodigo  != null ? Url.Action("Details", "Vendas",  new { id = conta.VendaCodigo  }) :
                                          conta.CompraCodigo != null ? Url.Action("Details", "Compras", new { id = conta.CompraCodigo }) : "#";
                            var tipo    = conta.VendaCodigo != null ? "Venda" : "Compra";
                            var diasRestantes = (conta.DataVencimento!.Value - DateTime.Today).Days;
                            var alertClass = diasRestantes <= 7 ? "text-danger fw-bold" : diasRestantes <= 15 ? "text-warning fw-semibold" : "";
                            <tr style="cursor:pointer" onclick="window.location='@link'">
                                <td class="text-muted">@conta.Codigo</td>
                                <td>@(conta.ParcelaNr ?? "—")</td>
                                <td class="@alertClass">
                                    @conta.DataVencimento?.ToString("dd/MM/yyyy")
                                    @if (diasRestantes <= 7)
                                    {
                                        <span class="badge badge-atrasado ms-1">@diasRestantes dias</span>
                                    }
                                </td>
                                <td class="fw-semibold">R$ @conta.Valor?.ToString("N2")</td>
                                <td>
                                    @if (conta.VendaCodigo != null)
                                    {
                                        <span class="badge" style="background:#d4edda;color:#155724">@tipo</span>
                                    }
                                    else
                                    {
                                        <span class="badge" style="background:#f8d7da;color:#721c24">@tipo</span>
                                    }
                                </td>
                            </tr>
                        }
                        @if (!contasVencer.Any())
                        {
                            <tr><td colspan="5" class="text-center text-muted py-4">Nenhuma conta a vencer nos próximos 30 dias</td></tr>
                        }
                    </tbody>
                    @if (contasVencer.Any())
                    {
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="3" class="text-end fw-bold">Total:</td>
                                <td class="fw-bold text-danger">R$ @totalVencer.ToString("N2")</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>
        </div>
    </div>

    @* ── Card 2: Contas recebidas no mês ── *@
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header d-flex justify-content-between align-items-center py-3"
                 style="background:#8b6f47; color:#fff;">
                <h5 class="mb-0"><i class="bi bi-check-circle me-2"></i>Recebidas no Mês</h5>
                <span class="badge fs-6 px-3 py-2" style="background:rgba(255,255,255,.2)">
                    Total: R$ @totalRecebido.ToString("N2")
                </span>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Parcela</th>
                            <th>Pago em</th>
                            <th>Valor</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var conta in contasRecebidas)
                        {
                            var link = conta.VendaCodigo != null
                                ? Url.Action("Details", "Vendas", new { id = conta.VendaCodigo })
                                : "#";
                            <tr style="cursor:pointer" onclick="window.location='@link'">
                                <td>@(conta.ParcelaNr ?? "—")</td>
                                <td>@conta.DataPagamento?.ToString("dd/MM/yyyy")</td>
                                <td class="fw-semibold text-success">R$ @conta.Valor?.ToString("N2")</td>
                            </tr>
                        }
                        @if (!contasRecebidas.Any())
                        {
                            <tr><td colspan="3" class="text-center text-muted py-4">Nenhum recebimento neste mês</td></tr>
                        }
                    </tbody>
                    @if (contasRecebidas.Any())
                    {
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="2" class="text-end fw-bold">Total:</td>
                                <td class="fw-bold text-success">R$ @totalRecebido.ToString("N2")</td>
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>
        </div>
    </div>

    @* ── Card 3: Últimas 5 vendas ── *@
    <div class="col-md-6">
        <div class="card shadow-sm h-100">
            <div class="card-header py-3" style="background:#8b6f47; color:#fff;">
                <h5 class="mb-0"><i class="bi bi-bag-check me-2"></i>Últimas Vendas</h5>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Data</th>
                            <th>Cliente</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var venda in ultimasVendas)
                        {
                            var linkVenda = Url.Action("Details", "Vendas", new { id = venda.Codigo });
                            <tr style="cursor:pointer" onclick="window.location='@linkVenda'">
                                <td>@venda.Data.ToString("dd/MM/yyyy")</td>
                                <td>@(venda.Cliente?.Pessoa?.Nome ?? "—")</td>
                                <td class="fw-semibold">
                                    @(venda.Total.HasValue ? "R$ " + venda.Total.Value.ToString("N2") : "—")
                                </td>
                            </tr>
                        }
                        @if (!ultimasVendas.Any())
                        {
                            <tr><td colspan="3" class="text-center text-muted py-4">Nenhuma venda cadastrada</td></tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (ultimasVendas.Any())
            {
                <div class="card-footer text-end py-2">
                    <a asp-controller="Vendas" asp-action="Index"
                       class="text-decoration-none small" style="color:#8b6f47">
                        Ver todas as vendas <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
            }
        </div>
    </div>

</div>
