@* ============================================================
   Views/Home/Login.cshtml
   Página de Login — NÃO usa o _Layout (tela cheia própria)
   Layout = null desabilita o layout padrão
============================================================ *@

@{
    Layout = null; // Sem sidebar nesta tela
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Móveis Carrara — Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { margin: 0; height: 100vh; display: flex; }
        .login-side {
            flex: 1; background: #f5f5f5;
            display: flex; align-items: center; justify-content: center;
            padding: 40px;
        }
        .login-box { width: 100%; max-width: 420px; }
        .login-box h1 { font-size: 2.5rem; font-weight: 400; margin-bottom: 2rem; }
        .btn-entrar {
            width: 100%; background: #8b6f47; color: #fff;
            border: none; padding: 12px; font-size: 1rem; border-radius: 6px;
        }
        .btn-entrar:hover { background: #6f5638; color: #fff; }
        .image-side {
            flex: 1; background: #8b6f47;
            display: flex; align-items: center; justify-content: center;
        }
        .image-side h2 { color: #fff; font-size: 3rem; font-weight: 300; }
    </style>
</head>
<body>

    <!-- Lado esquerdo: formulário -->
    <div class="login-side">
        <div class="login-box">
            <h1>Móveis Carrara</h1>

            @* ViewBag.Erro vem do Controller quando login falha *@
            @if (ViewBag.Erro != null)
            {
                <div class="alert alert-danger">@ViewBag.Erro</div>
            }

            @*
                asp-action e asp-controller são Tag Helpers do ASP.NET
                Geram automaticamente: action="/Home/Login" method="POST"
            *@
            <form asp-action="Login" asp-controller="Home" method="post">

                @* Token anti-falsificação (segurança) — obrigatório em formulários POST *@
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label">Usuário</label>
                    @*
                        name="usuario" deve bater com o parâmetro
                        do método Login(string usuario, string senha) no Controller
                    *@
                    <input type="text" class="form-control" name="usuario" required>
                </div>

                <div class="mb-3">
                    <label class="form-label">Senha</label>
                    <input type="password" class="form-control" name="senha" required>
                </div>

                <button type="submit" class="btn btn-entrar mt-2">Entrar</button>
            </form>
        </div>
    </div>

    <!-- Lado direito: decorativo -->
    <div class="image-side d-none d-md-flex">
        <h2>🪑</h2>
    </div>

</body>
</html>
