<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Móveis Carrara — @ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        :root {
            --marrom:       #8b6f47;
            --marrom-escuro:#6f5638;
        }

        body { min-height: 100vh; display: flex; flex-direction: row; }

        .sidebar {
            width: 220px;
            min-height: 100vh;
            background-color: var(--marrom);
            padding: 32px 24px;
            flex-shrink: 0;
            display: flex;
            flex-direction: column;
        }
        .sidebar h1 { color: #fff; font-size: 1.6rem; font-weight: 400; margin: 0; }
        .sidebar-underline { width: 50px; height: 3px; background: rgba(255,255,255,0.6); margin: 8px 0 28px; }
        .sidebar .nav-link { color: rgba(255,255,255,.8); font-size: 1rem; padding: 8px 0; }
        .sidebar .nav-link:hover,
        .sidebar .nav-link.active { color: #fff; font-weight: 600; }

        .main-wrapper { flex: 1; display: flex; flex-direction: column; min-width: 0; background: #f5f5f5; }

        .topbar {
            background: #fff;
            border-bottom: 1px solid #e8e0d6;
            padding: 0 20px;
            height: 52px;
            display: flex;
            align-items: center;
            gap: 2px;
            flex-shrink: 0;
            overflow-x: auto;
        }
        .topbar-link {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 5px 10px;
            border-radius: 6px;
            font-size: 0.85rem;
            color: #6b5a3e;
            text-decoration: none;
            white-space: nowrap;
        }
        .topbar-link:hover { background: #f5ede2; color: var(--marrom-escuro); }
        .topbar-sep { width: 1px; height: 20px; background: #e0d5c5; margin: 0 6px; flex-shrink: 0; }

        .btn-home {
            width: 34px; height: 34px; border-radius: 50%;
            background: var(--marrom); color: #fff;
            display: flex; align-items: center; justify-content: center;
            text-decoration: none; font-size: 0.95rem;
            transition: transform .2s;
            flex-shrink: 0;
            margin-left: auto;
        }
        .btn-home:hover { transform: scale(1.1); color: #fff; }

        .main-content { flex: 1; padding: 32px 36px; }

        .btn-carrara { background: var(--marrom); color: #fff; border: none; }
        .btn-carrara:hover { background: var(--marrom-escuro); color: #fff; }

        .alert { border-radius: 6px; }
        .table thead th { color: #888; font-weight: 500; font-size: .82rem; text-transform: uppercase; }

        .badge-pendente { background: #fff3cd; color: #856404; }
        .badge-pago     { background: #d4edda; color: #155724; }
        .badge-atrasado { background: #f8d7da; color: #721c24; }
    </style>
</head>
<body>

    <!-- SIDEBAR -->
    <div class="sidebar">
        <div>
            <h1>@(ViewData["SidebarTitulo"] ?? "")</h1>
            <div class="sidebar-underline"></div>
        </div>
        <nav class="nav flex-column">
            @RenderSection("SidebarMenu", required: false)
        </nav>
    </div>

    <!-- MAIN -->
    <div class="main-wrapper">

        <!-- Topbar global com todos os módulos -->
        <div class="topbar">
            <a href="/Clientes/Index"     class="topbar-link"><i class="bi bi-people"></i> Clientes</a>
            <a href="/Fornecedores/Index" class="topbar-link"><i class="bi bi-truck"></i> Fornecedores</a>
            <div class="topbar-sep"></div>
            <a href="/Vendas/Index"       class="topbar-link"><i class="bi bi-cart3"></i> Vendas</a>
            <a href="/Compras/Index"      class="topbar-link"><i class="bi bi-bag"></i> Compras</a>
            <div class="topbar-sep"></div>
            <a href="/TipoProdutos/Index" class="topbar-link"><i class="bi bi-box"></i> Produtos</a>
            <a href="/Materiais/Index"    class="topbar-link"><i class="bi bi-tools"></i> Materiais</a>
            <div class="topbar-sep"></div>
            <a href="/Contas/Index"       class="topbar-link"><i class="bi bi-cash-stack"></i> Contas</a>
            <a href="/Home/Dashboard"     class="btn-home" title="Dashboard"><i class="bi bi-house"></i></a>
        </div>

        <!-- Conteúdo da página -->
        <div class="main-content">

            @if (TempData["Sucesso"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle me-2"></i>@TempData["Sucesso"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["Erro"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Erro"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()
        </div>
    </div>

    @{ IgnoreSection("HeaderNav"); }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Marca o link ativo na topbar com base na URL atual -->
    <script>
        (function () {
            var path = window.location.pathname.toLowerCase();
            document.querySelectorAll('.topbar-link').forEach(function (a) {
                var href = a.getAttribute('href').toLowerCase().replace('/index', '');
                if (href !== '/' && path.toLowerCase().replace('/index', '').startsWith(href)) {
                    a.style.background = '#f0e6d6';
                    a.style.color = '#6f5638';
                    a.style.fontWeight = '600';
                }
            });
        })();
    </script>
</body>
</html>
