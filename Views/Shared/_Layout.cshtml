<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- RenderSection permite que cada página defina seu próprio título -->
    <title>Móveis Carrara — @ViewData["Title"]</title>

    <!-- Bootstrap 5 via CDN (sem precisar instalar nada) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet">

    <style>
        /* ── Cores do projeto ── */
        :root {
            --marrom:       #8b6f47;
            --marrom-escuro:#6f5638;
        }

        body { min-height: 100vh; display: flex; flex-direction: row; }

        /* ── Sidebar lateral ── */
        .sidebar {
            width: 260px;
            min-height: 100vh;
            background-color: var(--marrom);
            padding: 40px 30px;
            flex-shrink: 0;
        }
        .sidebar h1 { color: #fff; font-size: 2rem; font-weight: 400; }
        .sidebar-underline { width: 60px; height: 3px; background: #fff; margin: 8px 0 40px; }
        .sidebar .nav-link { color: rgba(255,255,255,.85); font-size: 1.1rem; padding: 10px 0; }
        .sidebar .nav-link:hover,
        .sidebar .nav-link.active { color: #fff; font-weight: 600; }

        /* ── Área principal ── */
        .main-content { flex: 1; background: #f5f5f5; padding: 40px; }

        /* ── Botão de voltar ao dashboard ── */
        .btn-dashboard {
            width: 46px; height: 46px; border-radius: 50%;
            background: var(--marrom); color: #fff;
            display: flex; align-items: center; justify-content: center;
            text-decoration: none; font-size: 1.2rem;
            box-shadow: 0 2px 8px rgba(0,0,0,.2);
            transition: transform .2s;
        }
        .btn-dashboard:hover { transform: scale(1.1); color: #fff; }

        /* ── Botões com cor marrom ── */
        .btn-carrara { background: var(--marrom); color: #fff; border: none; }
        .btn-carrara:hover { background: var(--marrom-escuro); color: #fff; }

        /* ── Alertas de sucesso/erro ── */
        .alert { border-radius: 6px; }

        /* ── Tabela ── */
        .table thead th { color: #888; font-weight: 500; font-size: .85rem; text-transform: uppercase; }

        /* ── Badges de status ── */
        .badge-pendente { background: #fff3cd; color: #856404; }
        .badge-pago     { background: #d4edda; color: #155724; }
        .badge-atrasado { background: #f8d7da; color: #721c24; }
    </style>
</head>
<body class="d-flex">

    <!-- ═══════════════════════════════════════════
         SIDEBAR — aparece em todas as páginas
         @ViewData["SidebarTitulo"] e SidebarMenu
         são definidos em cada View
    ═══════════════════════════════════════════ -->
    <div class="sidebar d-flex flex-column">
        <div>
            <h1>@ViewData["SidebarTitulo"]</h1>
            <div class="sidebar-underline"></div>
        </div>
        <nav class="nav flex-column">
            @RenderSection("SidebarMenu", required: false)
        </nav>
    </div>

    <!-- ═══════════════════════════════════════════
         CONTEÚDO PRINCIPAL
    ═══════════════════════════════════════════ -->
    <div class="main-content flex-grow-1">

        <!-- Botão de voltar ao dashboard (canto superior direito) -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                @RenderSection("HeaderNav", required: false)
            </div>
            <a href="/Home/Dashboard" class="btn-dashboard" title="Voltar ao Dashboard">
                <i class="bi bi-house"></i>
            </a>
        </div>

        <!-- Mensagem de sucesso (via TempData do controller) -->
        @if (TempData["Sucesso"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="bi bi-check-circle me-2"></i>@TempData["Sucesso"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- Mensagem de erro -->
        @if (TempData["Erro"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Erro"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

        <!-- RenderBody() = onde o conteúdo de cada View é inserido -->
        @RenderBody()
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>