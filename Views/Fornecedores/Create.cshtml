@model Pessoa

@{
    ViewData["Title"]         = "Cadastrar Fornecedor";
    ViewData["SidebarTitulo"] = "Fornecedores";
}

@section SidebarMenu {
    <a asp-action="Create" class="nav-link active"><i class="bi bi-plus-circle me-2"></i>Cadastrar</a>
    <a asp-action="Index"  class="nav-link"><i class="bi bi-list-ul me-2"></i>Listar</a>
}

@section HeaderNav {
    <div class="d-flex gap-4">
        <a asp-controller="Clientes" asp-action="Index" class="text-decoration-none" style="color:#8b6f47">Clientes</a>
        <a asp-controller="Contas"   asp-action="Index" class="text-decoration-none" style="color:#8b6f47">Contas</a>
    </div>
}

<div class="card shadow-sm" style="max-width:860px">
    <div class="card-body p-4">
        <h2 class="fw-normal mb-4">Cadastrar Fornecedor</h2>

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="alert alert-danger"
                 style="display:@(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")"></div>

            <h5 class="text-muted border-bottom pb-2 mb-3">Informações da empresa</h5>
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label asp-for="Nome" class="form-label">Razão Social</label>
                    <input asp-for="Nome" class="form-control" placeholder="Nome completo da empresa">
                    <span asp-validation-for="Nome" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="NomeSocial" class="form-label">Nome Fantasia</label>
                    <input asp-for="NomeSocial" class="form-control">
                </div>
            </div>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="Documento" class="form-label">CNPJ</label>
                    <input asp-for="Documento" class="form-control" placeholder="00.000.000/0001-00">
                </div>
            </div>

            <h5 class="text-muted border-bottom pb-2 mb-3">Localidade</h5>
            <div class="row g-3 mb-3">
                <div class="col-md-3">
                    <label asp-for="Cep" class="form-label">CEP</label>
                    <input asp-for="Cep" class="form-control">
                </div>
                <div class="col-md-5">
                    <label asp-for="Logradouro" class="form-label">Logradouro</label>
                    <input asp-for="Logradouro" class="form-control">
                </div>
                <div class="col-md-4">
                    <label asp-for="Numero" class="form-label">Número</label>
                    <input asp-for="Numero" class="form-control">
                </div>
            </div>
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label asp-for="Bairro" class="form-label">Bairro</label>
                    <input asp-for="Bairro" class="form-control">
                </div>
                <div class="col-md-8">
                    <label asp-for="Cidade" class="form-label">Cidade</label>
                    <input asp-for="Cidade" class="form-control">
                </div>
            </div>

            <h5 class="text-muted border-bottom pb-2 mb-3">Contato</h5>
            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label asp-for="Telefone" class="form-label">Telefone</label>
                    <input asp-for="Telefone" class="form-control">
                </div>
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label">Email</label>
                    <input asp-for="Email" class="form-control" type="email">
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-carrara px-4">
                    <i class="bi bi-check-lg me-1"></i>Cadastrar
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
            </div>
        </form>
    </div>
</div>
