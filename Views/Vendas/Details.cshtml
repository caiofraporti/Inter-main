@model Venda

@{
    ViewData["Title"]         = "Visualizar Venda";
    ViewData["SidebarTitulo"] = "Vendas";
    var itens       = ViewBag.Itens       as List<VendaProduto> ?? new List<VendaProduto>();
    var lancamentos = ViewBag.Lancamentos as List<Lancamento>   ?? new List<Lancamento>();
}

@section SidebarMenu {
    <a asp-action="Create" class="nav-link"><i class="bi bi-plus-circle me-2"></i>Cadastrar</a>
    <a asp-action="Index"  class="nav-link"><i class="bi bi-list-ul me-2"></i>Listar</a>
    <a class="nav-link active"><i class="bi bi-eye me-2"></i>Visualizar</a>
}

<div style="max-width:900px">

    @* Cabeçalho da venda *@
    <div class="card shadow-sm mb-4">
        <div class="card-header d-flex justify-content-between align-items-center py-3"
             style="background:#8b6f47; color:#fff;">
            <h5 class="mb-0"><i class="bi bi-receipt me-2"></i>Venda #@Model.Codigo</h5>
            <div class="d-flex gap-2">
                <a asp-action="Edit" asp-route-id="@Model.Codigo"
                   class="btn btn-sm btn-light" style="color:#8b6f47">
                    <i class="bi bi-pencil me-1"></i>Alterar
                </a>
                <a asp-action="Index" class="btn btn-sm btn-outline-light">
                    <i class="bi bi-arrow-left me-1"></i>Voltar
                </a>
            </div>
        </div>
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="text-muted small mb-1">Data</div>
                    <div class="fw-semibold">@Model.Data.ToString("dd/MM/yyyy")</div>
                </div>
                <div class="col-md-3">
                    <div class="text-muted small mb-1">Nº de Parcelas</div>
                    <div class="fw-semibold">@(Model.NrParcelas?.ToString() ?? "—")</div>
                </div>
                <div class="col-md-3">
                    <div class="text-muted small mb-1">Total</div>
                    <div class="fw-semibold text-success fs-5">
                        R$ @(Model.Total.HasValue ? Model.Total.Value.ToString("N2") : "0,00")
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="text-muted small mb-1">Valor por Parcela</div>
                    <div class="fw-semibold">
                        @if (Model.Total.HasValue && Model.NrParcelas.HasValue && Model.NrParcelas.Value > 0)
                        {
                            @("R$ " + (Model.Total.Value / Model.NrParcelas.Value).ToString("N2"))
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted small mb-1">Cliente</div>
                    <div class="fw-semibold">@(Model.Cliente?.Pessoa?.Nome ?? "—")</div>
                </div>
                <div class="col-md-6">
                    <div class="text-muted small mb-1">Funcionário Responsável</div>
                    <div class="fw-semibold">@(Model.Funcionario?.Pessoa?.Nome ?? "—")</div>
                </div>
            </div>
        </div>
    </div>

    @* Itens da venda *@
    <div class="card shadow-sm mb-4">
        <div class="card-header py-3" style="background:#f5f0ea;">
            <h6 class="mb-0 fw-semibold" style="color:#8b6f47">
                <i class="bi bi-box-seam me-2"></i>Itens da Venda
            </h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Produto</th>
                            <th>Descrição</th>
                            <th class="text-center">Qtd</th>
                            <th class="text-end">Preço Unit.</th>
                            <th>Dimensões</th>
                            <th class="text-end">Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in itens)
                        {
                            <tr>
                                <td class="text-muted">@item.Item</td>
                                <td class="fw-semibold">@(item.Produto?.NomeProduto ?? "—")</td>
                                <td class="text-muted">@(item.Descricao ?? "—")</td>
                                <td class="text-center">@item.Qtd</td>
                                <td class="text-end">R$ @item.Preco.ToString("N2")</td>
                                <td>@(item.Dimensoes ?? "—")</td>
                                <td class="text-end fw-semibold">R$ @((item.Qtd * item.Preco).ToString("N2"))</td>
                            </tr>
                        }
                        @if (!itens.Any())
                        {
                            <tr><td colspan="7" class="text-center text-muted py-4">Nenhum item cadastrado</td></tr>
                        }
                    </tbody>
                    @if (itens.Any())
                    {
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="6" class="text-end fw-bold">Total Geral:</td>
                                <td class="text-end fw-bold text-success">
                                    R$ @(Model.Total.HasValue ? Model.Total.Value.ToString("N2") : "0,00")
                                </td>
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>
        </div>
    </div>

    @* Parcelas *@
    <div class="card shadow-sm">
        <div class="card-header py-3" style="background:#f5f0ea;">
            <h6 class="mb-0 fw-semibold" style="color:#8b6f47">
                <i class="bi bi-cash-stack me-2"></i>Parcelas
            </h6>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Parcela</th>
                            <th>Valor</th>
                            <th>Vencimento</th>
                            <th>Pagamento</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in lancamentos)
                        {
                            string badgeClass = l.Situacao?.Descricao switch {
                                "Pago"     => "badge-pago",
                                "Atrasado" => "badge-atrasado",
                                _          => "badge-pendente"
                            };
                            <tr>
                                <td>@(l.ParcelaNr ?? "—")</td>
                                <td class="fw-semibold">R$ @l.Valor?.ToString("N2")</td>
                                <td>@l.DataVencimento?.ToString("dd/MM/yyyy")</td>
                                <td>@(l.DataPagamento?.ToString("dd/MM/yyyy") ?? "—")</td>
                                <td>
                                    <span class="badge @badgeClass px-2 py-1 rounded-pill">
                                        @(l.Situacao?.Descricao ?? "Pendente")
                                    </span>
                                </td>
                            </tr>
                        }
                        @if (!lancamentos.Any())
                        {
                            <tr><td colspan="5" class="text-center text-muted py-4">Nenhuma parcela gerada</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
