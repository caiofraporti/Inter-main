@model Produto

@{
    ViewData["Title"]         = "Cadastrar Tipo de Produto";
    ViewData["SidebarTitulo"] = "Produtos";
}

@section SidebarMenu {
    <a asp-action="Create" class="nav-link active"><i class="bi bi-plus-circle me-2"></i>Cadastrar</a>
    <a asp-action="Index"  class="nav-link"><i class="bi bi-list-ul me-2"></i>Listar</a>
}

@section HeaderNav {
    <div class="d-flex gap-4">
        <a asp-controller="Materiais" asp-action="Index" class="text-decoration-none" style="color:#8b6f47">Materiais</a>
        <a asp-controller="Vendas"    asp-action="Index" class="text-decoration-none" style="color:#8b6f47">Vendas</a>
        <a asp-controller="Compras"   asp-action="Index" class="text-decoration-none" style="color:#8b6f47">Compras</a>
    </div>
}

<div class="card shadow-sm" style="max-width:720px">
    <div class="card-body p-4">
        <h2 class="fw-normal mb-4">Cadastrar Tipo de Produto</h2>

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
        {
            <div class="alert alert-danger">
                <strong>Corrija os erros abaixo:</strong>
                <div asp-validation-summary="All"></div>
            </div>
        }

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <h5 class="text-muted border-bottom pb-2 mb-3">Informações do produto</h5>
            <div class="row g-3 mb-3">
                <div class="col-md-8">
                    <label asp-for="NomeProduto" class="form-label">Nome do Produto *</label>
                    <input asp-for="NomeProduto" class="form-control" placeholder="Ex: Armário de Cozinha">
                    <span asp-validation-for="NomeProduto" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="ValorUnitario" class="form-label">Valor Unitário (R$) *</label>
                    <input asp-for="ValorUnitario" class="form-control" type="number" step="0.01" placeholder="0,00">
                    <span asp-validation-for="ValorUnitario" class="text-danger small"></span>
                </div>
            </div>
            <div class="row g-3 mb-4">
                <div class="col-12">
                    <label asp-for="Descricao" class="form-label">Descrição</label>
                    <textarea asp-for="Descricao" class="form-control" rows="3"
                              placeholder="Descrição detalhada do tipo de produto..."></textarea>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-carrara px-4">
                    <i class="bi bi-check-lg me-1"></i>Cadastrar
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
            </div>
        </form>
    </div>
</div>
