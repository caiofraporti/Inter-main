@model List<Material>

@{
    ViewData["Title"]         = "Materiais";
    ViewData["SidebarTitulo"] = "Materiais";
}

@section SidebarMenu {
    <a asp-action="Create" class="nav-link"><i class="bi bi-plus-circle me-2"></i>Cadastrar</a>
    <a asp-action="Index"  class="nav-link active"><i class="bi bi-list-ul me-2"></i>Listar</a>
}

@section HeaderNav {
    <div class="d-flex gap-4">
        <a asp-controller="Produtos" asp-action="Index" class="text-decoration-none" style="color:#8b6f47">Produtos</a>
        <a asp-controller="Vendas"       asp-action="Index" class="text-decoration-none" style="color:#8b6f47">Vendas</a>
        <a asp-controller="Compras"      asp-action="Index" class="text-decoration-none" style="color:#8b6f47">Compras</a>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-normal">Todos os materiais</h2>
    <input type="text" id="busca" class="form-control w-auto"
           placeholder="🔍 Procurar..." onkeyup="filtrarTabela()">
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0" id="tabela">
            <thead class="table-light">
                <tr>
                    <th>#</th>
                    <th>Nome do Material</th>
                    <th>Descrição</th>
                    <th>Preço</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Model)
                {
                    <tr>
                        <td class="text-muted">@m.Codigo</td>
                        <td>@m.NomeMaterial</td>
                        <td class="text-muted">@(m.Descricao ?? "—")</td>
                        <td>R$ @m.Preco.ToString("N2")</td>
                        <td>
                            <div class="d-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@m.Codigo"
                                   class="btn btn-sm" style="background:#7fd4c1">Alterar</a>
                                <form asp-action="Delete" asp-route-id="@m.Codigo"
                                      method="post" style="display:inline"
                                      onsubmit="return confirm('Excluir este material?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger">Excluir</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">Nenhum material cadastrado</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script>
function filtrarTabela() {
    const filtro = document.getElementById("busca").value.toLowerCase();
    document.querySelectorAll("#tabela tbody tr").forEach(linha => {
        linha.style.display = linha.innerText.toLowerCase().includes(filtro) ? "" : "none";
    });
}
</script>
