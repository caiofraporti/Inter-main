@model Material

@{
    ViewData["Title"]         = "Cadastrar Material";
    ViewData["SidebarTitulo"] = "Materiais";
}

@section SidebarMenu {
    <a asp-action="Create" class="nav-link active"><i class="bi bi-plus-circle me-2"></i>Cadastrar</a>
    <a asp-action="Index"  class="nav-link"><i class="bi bi-list-ul me-2"></i>Listar</a>
}

@section HeaderNav {
    <div class="d-flex gap-4">
        <a asp-controller="Produtos" asp-action="Index" class="text-decoration-none" style="color:#8b6f47">Produtos</a>
        <a asp-controller="Vendas"       asp-action="Index" class="text-decoration-none" style="color:#8b6f47">Vendas</a>
        <a asp-controller="Compras"      asp-action="Index" class="text-decoration-none" style="color:#8b6f47">Compras</a>
    </div>
}

<div class="card shadow-sm" style="max-width:720px">
    <div class="card-body p-4">
        <h2 class="fw-normal mb-4">Cadastrar Material</h2>

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
        {
            <div class="alert alert-danger">
                <strong>Corrija os erros abaixo:</strong>
                <div asp-validation-summary="All"></div>
            </div>
        }

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <h5 class="text-muted border-bottom pb-2 mb-3">Informações do material</h5>
            <div class="row g-3 mb-3">
                <div class="col-md-8">
                    <label asp-for="NomeMaterial" class="form-label">Nome do Material *</label>
                    <input asp-for="NomeMaterial" class="form-control" placeholder="Ex: MDF 15mm">
                    <span asp-validation-for="NomeMaterial" class="text-danger small"></span>
                </div>
                
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-carrara px-4">
                    <i class="bi bi-check-lg me-1"></i>Cadastrar
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
            </div>
        </form>
    </div>
</div>
